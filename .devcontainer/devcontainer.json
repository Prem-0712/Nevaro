{
  "name": "NEVARO",
  "dockerComposeFile": "docker-compose.dev.yml",
  "service": "nevaro_backend",
  "workspaceFolder": "/Nevaro",
  "forwardPorts": [
    8000,
    5173
  ],
  "postStartCommand": "cd backend && make flush && make load",
  "remoteUser": "root",
  "containerUser": "root",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.vscode-python-envs",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.black-formatter",
        "ms-vscode.vscode-typescript-next",
        "ms-vscode.js-debug-nightly",
        "ecmel.vscode-html-css",
        "batisteo.vscode-django",
        "dsznajder.es7-react-js-snippets",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "codezombiech.gitignore",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "waderyan.gitblame",
        "esbenp.prettier-vscode",
        "loclv.agent-md-formatter"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": [
              "-l"
            ]
          }
        },
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },
  "postCreateCommand": "chsh -s /bin/bash root && echo 'export PS1=\"\\u@\\h:\\w\\\\$ \"' >> ~/.bashrc && echo 'alias ls=\"ls --color=never\"' >> ~/.bashrc"
}