{
  "name": "NEVARO Backend",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "nevaro_backend",
  "workspaceFolder": "/workspaces/NEVARO/backend",
  "forwardPorts": [8000],
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "batisteo.vscode-django@1.15.0",
        "eamodio.gitlens@17.8.1",
        "mhutchie.git-graph@1.30.0",
        "ms-azuretools.vscode-containers@2.3.0",
        "ms-azuretools.vscode-docker@2.0.0",
        "ms-python.debugpy@2025.18.0",
        "ms-python.python@2026.0.0",
        "ms-python.vscode-pylance@2025.10.4",
        "ms-python.vscode-python-envs@1.16.0",
        "waderyan.gitblame@11.2.0"
      ]
    }
  }
}